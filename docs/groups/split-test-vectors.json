    { "description": "Your Treat with the payer as the only participant is rejected", "amountMinor": 100, "kind": "others_cover", "participants": ["a"], "payerId": "a", "params": {} },
    { "description": "Unknown kind is rejected", "amountMinor": 100, "kind": "not_a_real_kind", "participants": ["a"], "payerId": "a", "params": {} }
