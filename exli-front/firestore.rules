rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // --- Helpers (Groups) ---
    function signedIn() { return request.auth != null; }
    function groupDoc(groupId) { return get(/databases/$(database)/documents/groups/$(groupId)); }
    function isMember(group) { return signedIn() && request.auth.uid in group.data.memberIds; }
    function isAdmin(group) { return isMember(group) && group.data.members[request.auth.uid].role == 'admin'; }

    // 1. User Data (Private)
    match /users/{userId}/{document=**} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    // 2. Whitelist (Read Only for Users)
    match /whitelist/{email} {
      allow read: if request.auth != null;
    }

    // 3. Public Categories (Community Feature)
    // Anyone logged in can read/create, but NOT delete/overwrite others
    match /artifacts/{appId}/public/data/categories/{categoryId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null;
      // No update/delete allowed to prevent vandalism
    }

    // 4. Groups (Shared)
    // Members read live via onSnapshot. ALL writes go through the backend (Admin SDK bypasses rules).
    match /groups/{groupId} {
      allow read: if isMember(resource);
      allow write: if false;

      // Admins see all requests; a requester sees only their own
      match /joinRequests/{uid} {
        allow read: if isAdmin(groupDoc(groupId)) || (signedIn() && request.auth.uid == uid);
        allow write: if false;
      }

      // activity, expenses, settlements... (joinRequests excluded: rules OR together, so it must not match here)
      match /{subcollection}/{docId} {
        allow read: if subcollection != 'joinRequests' && isMember(groupDoc(groupId));
        allow write: if false;
      }
    }

    // Invite tokens are backend-only (never readable, so they can't be enumerated)
    match /groupInvites/{token} {
      allow read, write: if false;
    }

    // Default Lock
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
